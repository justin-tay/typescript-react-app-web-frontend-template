{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/*", "@/features/*", "**/app/**", "**/features/**"],
                "message": "shared code must not import from app or features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/*", "**/app/**"],
                "message": "features must not import from app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/account/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "**/app/**",
                  "@/features/*",
                  "**/features/**",
                  "../admin/*",
                  "../audit/*",
                  "../home/*",
                  "../login/*",
                  "../review/*",
                  "../settings/*"
                ],
                "message": "features must not import from app or from other features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/admin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
